# ===========================
# Unity .gitignore
# ===========================

# --- Unity 자동 생성 폴더 ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# --- Unity 메모리/캐시 ---
/[Mm]emoryCaptures/
/[Rr]ecordings/

# --- Gradle (Android 빌드) ---
/[Ee]xport[Ee]d[Oo]bj/

# --- Asset Import 캐시 ---
sysinfo.txt
*.stackdump

# --- IDE 캐시 ---
*.lscache

# --- IDE ---
# Visual Studio
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# JetBrains Rider
.idea/
*.iml

# VS Code
.vscode/

# --- OS ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Unity 빌드 결과물 ---
*.apk
*.aab
*.unitypackage
*.app

# --- Crashlytics ---
crashlytics-build.properties

# --- 스크린샷 (MCP에서 생성한 것) ---
Assets/Screenshots/

# --- TextMeshPro (첫 임포트 시 자동 생성) ---
Assets/TextMesh Pro/
